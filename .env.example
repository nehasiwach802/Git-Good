# Template only. Set secrets in the hosting dashboard; do not commit real values.
# uvicorn does not load this file automatically. Locally pass --env-file .env.
DATA_DIR=./data
WORKER_ENABLED=true
VISION_ENABLED=false
QWEN_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Nonblank FIREBASE_SERVICE_ACCOUNT_JSON overrides GOOGLE_APPLICATION_CREDENTIALS.
# Both credential project_id and FIREBASE_PROJECT_ID must match.
DEFAULT_LAB_ID=
