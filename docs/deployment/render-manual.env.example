# Render backend configuration: manual circuit review, no Gemini/Qwen calls.
FIREBASE_PROJECT_ID=circuitly-b1f4c
# REQUIRED: paste the ENTIRE service-account JSON downloaded from Firebase here
# using Render's value editor. Do not paste only the private_key field.
# This template intentionally contains no private credential.
FIREBASE_SERVICE_ACCOUNT_JSON=
DEFAULT_LAB_ID=circuitly-lab
DATA_DIR=/app/data
WORKER_ENABLED=true
VISION_ENABLED=false
QWEN_ENABLED=false
# A persistent Render disk must separately be mounted at /app/data.
# Keep existing team-specific DEFAULT_LAB_ID if one is already established.
# Leave GOOGLE_APPLICATION_CREDENTIALS unset when using JSON-in-environment.
