FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ngspice gosu && rm -rf /var/lib/apt/lists/*
COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt
COPY backend/ backend/
COPY reasoning/ reasoning/
COPY labvision/ labvision/
COPY lab_memory.py meko_transport.py mentor.py ml3_service.py ml3_http.py knowledge_lifecycle.py outcome_writer.py equipment_flags.py qwen_transport.py ./
RUN python -c "from backend.app import app; assert '/api/v1/sessions/{session_id}/image' in app.openapi()['paths']"
RUN useradd --create-home appuser && mkdir -p /app/data && chown appuser:appuser /app/data
RUN sed -i 's/\r$//' backend/docker-entrypoint.sh && chmod 755 backend/docker-entrypoint.sh
ENV PORT=8000
ENV DATA_DIR=/app/data
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8000')+'/health',timeout=4)"
ENTRYPOINT ["/app/backend/docker-entrypoint.sh"]
CMD ["sh", "-c", "exec uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --limit-concurrency 20 --timeout-graceful-shutdown 40 --no-access-log"]
